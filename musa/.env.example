# --- Platform ---
PORT=8080
# Password for /admin (user: admin). Required to use the admin console.
MUSA_ADMIN_PASSWORD=
# Hours between Scout runs over enabled sources (data/sources.json)
MUSA_SCOUT_HOURS=6
# Claude-powered concierge (optional). Without a key the concierge answers from the sourced knowledge base only.
ANTHROPIC_API_KEY=
MUSA_CONCIERGE_MODEL=claude-opus-5-5

# --- WhatsApp bot (served by the same process) ---
# Copy this file to .env (never commit .env). Values come from developers.facebook.com → your app → WhatsApp.
WA_VERIFY_TOKEN=choose-a-long-random-string
WA_APP_SECRET=
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v23.0
# Prices and payment accounts live in data/payments.json (business accounts only).
# Stripe: Dashboard → Developers → Webhooks → endpoint https://<host>/stripe/webhook, event checkout.session.completed
STRIPE_WEBHOOK_SECRET=
# Public URL of https://<host>/admin/leads, linked from the Dashy 'MUSA Leads' page
MUSA_ADMIN_URL=
