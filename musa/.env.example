# Copy to .env (never commit .env). Values come from developers.facebook.com → your app → WhatsApp.
WA_VERIFY_TOKEN=choose-a-long-random-string
WA_APP_SECRET=
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v23.0
MUSA_REPORT_PRICE_PKR=4500
MUSA_PAYMENT_LINK=
# Private follow-up view at /admin/leads (user: admin). Leave empty to disable.
MUSA_ADMIN_PASSWORD=
# Public URL of that view, linked from the Dashy 'MUSA Leads' page
MUSA_ADMIN_URL=
